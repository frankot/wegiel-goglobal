generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  EMPLOYEE
}

enum EmissionScope {
  SCOPE_1
  SCOPE_2
}

enum SourceType {
  STATIONARY_INSTALLATION
  COMPANY_VEHICLE
  ELECTRICITY
  HEAT
  COOLING
}

enum FactorSource {
  KOBIZE
  GHG_PROTOCOL
  CUSTOM
}

enum EntryStatus {
  DRAFT
  VERIFIED
  CORRECTED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String    @default("")
  passwordHash      String
  role              UserRole  @default(EMPLOYEE)
  active            Boolean   @default(true)
  invitationToken   String?   @unique
  invitationExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authoredEntries  EmissionEntry[] @relation("Author")
  verifiedEntries  EmissionEntry[] @relation("Verifier")
  uploadedInvoices Invoice[]       @relation("Uploader")
}

model EmissionSource {
  id                 String        @id @default(cuid())
  name               String        @unique
  type               SourceType
  scope              EmissionScope
  defaultFactorId    String?
  unit               String
  active             Boolean       @default(true)
  registrationNumber String?
  location           String?

  // Matching keys
  ppeNumber   String? @unique
  meterNumber String?
  supplierNip String?

  defaultFactor EmissionFactor? @relation(fields: [defaultFactorId], references: [id])
  entries       EmissionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FactorCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  factors EmissionFactor[]
}

model EmissionFactor {
  id         String        @id @default(cuid())
  name       String
  categoryId String
  value      Decimal       @db.Decimal(12, 6)
  unit       String
  source     FactorSource
  scope      EmissionScope
  validFrom  DateTime
  validTo    DateTime
  parentId   String?

  category FactorCategory   @relation(fields: [categoryId], references: [id])
  parent   EmissionFactor?  @relation("VersionHistory", fields: [parentId], references: [id])
  versions EmissionFactor[] @relation("VersionHistory")

  sources EmissionSource[]
  entries EmissionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String?
  issueDate     DateTime?
  receiptDate   DateTime?
  periodStart   DateTime?
  periodEnd     DateTime?
  sourceFormat  String    @default("MANUAL") // KSEF_XML | MANUAL
  importStatus  String    @default("PENDING")

  // Invoice identity
  ksefNumber   String? @unique
  supplierNip  String?
  supplierName String?
  buyerNip     String?

  rawPayload Json?

  uploadedById String?
  uploadedBy   User?   @relation("Uploader", fields: [uploadedById], references: [id])

  entries     EmissionEntry[]
  attachments InvoiceAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierNip, invoiceNumber])
}

model InvoiceAttachment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  kind     String // SOURCE_XML | EVIDENCE_PDF
  fileName String
  mimeType String
  blobUrl  String

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model EmissionEntry {
  id String @id @default(cuid())

  sourceId String
  source   EmissionSource @relation(fields: [sourceId], references: [id])

  factorId String
  factor   EmissionFactor @relation(fields: [factorId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  entryDate   DateTime
  periodStart DateTime?
  periodEnd   DateTime?
  quantity    Decimal   @db.Decimal(12, 4)
  unit        String

  originalQuantity Decimal? @db.Decimal(14, 4)
  originalUnit     String?

  factorSnapshotValue Decimal @db.Decimal(12, 6)
  factorSnapshotUnit  String

  co2eKg  Decimal @db.Decimal(12, 4)
  co2eTon Decimal @db.Decimal(16, 6)

  status EntryStatus @default(DRAFT)
  note   String?

  authorId String
  author   User   @relation("Author", fields: [authorId], references: [id])

  verifierId String?
  verifier   User?   @relation("Verifier", fields: [verifierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?

  createdAt DateTime @default(now())
}

/// Single company row
model Company {
  id         String  @id @default("default")
  name       String
  shortName  String?
  nip        String?
  regon      String?
  krs        String?
  street     String?
  postalCode String?
  city       String?
  country    String?

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model LoginAttempt {
  id        String  @id @default(cuid())
  email     String
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}
