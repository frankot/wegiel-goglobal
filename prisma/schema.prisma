generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  EMPLOYEE
}

enum EmissionScope {
  SCOPE_1
  SCOPE_2
}

enum SourceType {
  STATIONARY_INSTALLATION
  COMPANY_VEHICLE
  ELECTRICITY
  HEAT
  COOLING
}

enum FactorSource {
  KOBIZE
  GHG_PROTOCOL
  CUSTOM
}

enum EntryStatus {
  DRAFT
  VERIFIED
  CORRECTED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String    @default("")
  passwordHash      String
  role              UserRole  @default(EMPLOYEE)
  active            Boolean   @default(true)
  invitationToken   String?   @unique
  invitationExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authoredEntries EmissionEntry[] @relation("Author")
  verifiedEntries EmissionEntry[] @relation("Verifier")
}

model EmissionSource {
  id                 String       @id @default(cuid())
  name               String       @unique
  type               SourceType
  scope              EmissionScope
  defaultFactorId    String?
  unit               String
  active             Boolean      @default(true)
  registrationNumber String?
  location           String?

  defaultFactor EmissionFactor? @relation(fields: [defaultFactorId], references: [id])
  entries       EmissionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmissionFactor {
  id        String       @id @default(cuid())
  name      String
  category  String
  value     Decimal      @db.Decimal(12, 6)
  unit      String
  source    FactorSource
  scope     EmissionScope
  validFrom DateTime
  validTo   DateTime
  parentId  String?

  parent   EmissionFactor?  @relation("VersionHistory", fields: [parentId], references: [id])
  versions EmissionFactor[] @relation("VersionHistory")

  sources EmissionSource[]
  entries EmissionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String?
  issueDate     DateTime?
  receiptDate   DateTime?
  source        String    @default("MANUAL")
  importStatus  String    @default("PENDING")
  sourceFileUrl String?

  entries EmissionEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmissionEntry {
  id        String @id @default(cuid())

  sourceId String
  source   EmissionSource @relation(fields: [sourceId], references: [id])

  factorId String
  factor   EmissionFactor @relation(fields: [factorId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  entryDate   DateTime
  periodStart DateTime?
  periodEnd   DateTime?
  quantity    Decimal    @db.Decimal(12, 4)
  unit        String

  factorSnapshotValue Decimal @db.Decimal(12, 6)
  factorSnapshotUnit  String

  co2eKg  Decimal @db.Decimal(12, 4)
  co2eTon Decimal @db.Decimal(12, 4)

  status EntryStatus @default(DRAFT)
  note   String?

  authorId String
  author   User   @relation("Author", fields: [authorId], references: [id])

  verifierId String?
  verifier   User? @relation("Verifier", fields: [verifierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?

  createdAt DateTime @default(now())
}
